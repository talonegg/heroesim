node_modules/
dist/
coverage/
*.tsbuildinfo
.env

# Local saves, harness samples and front-end build and test output
.saves/
harness/samples/

# Every harness run writes a report here, its Markdown and, for a play sweep, its JSON beside it.
# A report a DL entry or a release's Gate cites is committed, both files force-added with the line a
# passing `gate` run prints, `git add -f harness/reports/<name>.md harness/reports/<name>.json`; once
# tracked, Git follows them despite this line (M1-S10, DL-13; v1.1.6-S2, DL-186 item 28).
harness/reports/*
web/dist/
test-results/
playwright-report/
.wrangler/

# The portrait tool's inbox (v1.1.3-S2, DL-135 item 11): uploads wait here, in guildmaster/ or hero/
# and perhaps male/ or female/, and are never committed; only each folder's .gitkeep is.
media/inbox/**
!media/inbox/*/
!media/inbox/*/.gitkeep

# The content editor's pending edits (v1.1.4-S12, DL-161), held between its commands until "Finish"
.editor/

# Agent worktrees are separate checkouts, never part of this one
.claude/worktrees/
