node_modules/
dist/
coverage/
*.tsbuildinfo
.env

# Local saves, harness samples and front-end build and test output
.saves/
harness/samples/

# Every harness run writes a report here. Only the report of a milestone's tagged run is
# committed, force-added with `git add -f harness/reports/m<n>-<date>.md`; once tracked, Git
# follows it despite this line (M1-S10, DL-13).
harness/reports/*
web/dist/
test-results/
playwright-report/
.wrangler/

# The portrait tool's inbox (v1.1.3-S2, DL-135 item 11): uploads wait here, in guildmaster/ or hero/
# and perhaps male/ or female/, and are never committed; only each folder's .gitkeep is.
media/inbox/**
!media/inbox/*/
!media/inbox/*/.gitkeep

# The content editor's pending edits (v1.1.4-S12, DL-161), held between its commands until "Finish"
.editor/

# Agent worktrees are separate checkouts, never part of this one
.claude/worktrees/
