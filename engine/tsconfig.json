{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // Node's types serve the tests (the boundary test reads and writes files). The engine's
    // own source may not import Node: ESLint forbids it (ADR-0007).
    "types": ["node"]
  },
  // The defaults' values, `src/config.json`, are imported as JSON (DL-204).
  "include": ["src", "src/**/*.json"]
}
